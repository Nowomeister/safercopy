; SaferCopy.ct -- English
; $VER: SaferCopy.ct 1.3 (2026)
## version 1
## language english
## codeset 0

MSG_STARTUP
SaferCopy: buffer %lu KB%s%s%s%s%s
MSG_OPT_VERIFY
, VERIFY
MSG_OPT_DATES
, DATES
MSG_OPT_UPDATE
, UPDATE
MSG_OPT_VERBOSE
, VERBOSE
MSG_OPT_MAXERR
, MAXERR=%ld
MSG_COPYING
Copy    %s -> %s
MSG_IGNORED
  Skip    %s (up to date)
MSG_DEST_INCOMPLETE
  [dest incomplete: %ld/%ld bytes]
MSG_VERIFYING
  Verify  %s ...
MSG_VERIFY_OK
 OK
MSG_VERIFY_FAIL
 FAILED!
MSG_FROM_REQUIRED
SaferCopy: FROM is required
MSG_NO_MEM_BUF
SaferCopy: cannot allocate %lu bytes for buffer
MSG_NO_MKDIR_DEST
SaferCopy: cannot create destination directory
MSG_NO_MKDIR
SaferCopy: cannot create
MSG_IS_DIR_USE_ALL
SaferCopy: '%s' is a directory - use ALL
MSG_NO_ANCHORPATH
SaferCopy: out of memory (AnchorPath)
MSG_SRC_INACCESSIBLE
SaferCopy: source not accessible
MSG_CANNOT_OPEN
SaferCopy: cannot open
MSG_CANNOT_CREATE
SaferCopy: cannot create
MSG_WRITE_INCOMPLETE
SaferCopy: INCOMPLETE WRITE %s (wanted %ld, wrote %ld) - file deleted!
MSG_READ_ERROR
SaferCopy: read error
MSG_ALLOC_DOS_FAILED
SaferCopy: AllocDosObject failed
MSG_EXAMINE_FAILED
SaferCopy: Examine failed
MSG_VERIFY_FAILED_DEL
SaferCopy: verify failed - file deleted
MSG_SETDATE_WARNING
SaferCopy: warning - SetFileDate failed
MSG_VERIFY_READ_ERR
SaferCopy: verify - read error
MSG_VERIFY_SIZE_DIFF
SaferCopy: verify - size mismatch (%ld vs %ld)
MSG_VERIFY_CONTENT
SaferCopy: verify - content mismatch
MSG_SUMMARY_HEADER
--- Summary: %ld error(s) ---
MSG_ERRBUF_TRUNCATED
  [%ld message(s) truncated - error buffer full]
MSG_FINAL_REPORT
SaferCopy: %ld copied  %ld skipped  %ld error(s)%s
MSG_ABORT_TAG
  [ABORT: MAXERR reached]
MSG_ABORT
SaferCopy: MAXERR=%ld reached - aborting
MSG_CHECK_MISSING
  Missing  %s
MSG_CHECK_OK
  OK       %s
MSG_CHECK_MISMATCH
  SizeDiff %s  (src=%ld  dst=%ld)
MSG_OPT_CHECK
, CHECK
