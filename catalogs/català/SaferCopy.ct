; SaferCopy.ct -- Català
; $VER: SaferCopy.ct 1.3 (2026)
## version 1
## language català
## codeset 0

MSG_STARTUP
SaferCopy: buffer %lu KB%s%s%s%s%s
MSG_OPT_VERIFY
, VERIFY
MSG_OPT_DATES
, DATES
MSG_OPT_UPDATE
, UPDATE
MSG_OPT_VERBOSE
, VERBOSE
MSG_OPT_MAXERR
, MAXERR=%ld
MSG_COPYING
Copiar  %s -> %s
MSG_IGNORED
  Ometre  %s (actualitzat)
MSG_DEST_INCOMPLETE
  [destinacio incompleta: %ld/%ld bytes]
MSG_VERIFYING
  Verificar %s ...
MSG_VERIFY_OK
 OK
MSG_VERIFY_FAIL
 FALLADA!
MSG_FROM_REQUIRED
SaferCopy: FROM es obligatori
MSG_NO_MEM_BUF
SaferCopy: no es pot assignar %lu bytes per al buffer
MSG_NO_MKDIR_DEST
SaferCopy: no es pot crear el directori de destinacio
MSG_NO_MKDIR
SaferCopy: no es pot crear
MSG_IS_DIR_USE_ALL
SaferCopy: '%s' es un directori - useu ALL
MSG_NO_ANCHORPATH
SaferCopy: memoria insuficient (AnchorPath)
MSG_SRC_INACCESSIBLE
SaferCopy: origen inaccessible
MSG_CANNOT_OPEN
SaferCopy: no es pot obrir
MSG_CANNOT_CREATE
SaferCopy: no es pot crear
MSG_WRITE_INCOMPLETE
SaferCopy: ESCRIPTURA INCOMPLETA %s (demanat %ld, escrit %ld) - fitxer esborrat!
MSG_READ_ERROR
SaferCopy: error de lectura
MSG_ALLOC_DOS_FAILED
SaferCopy: AllocDosObject ha fallat
MSG_EXAMINE_FAILED
SaferCopy: Examine ha fallat
MSG_VERIFY_FAILED_DEL
SaferCopy: verificacio fallada - fitxer esborrat
MSG_SETDATE_WARNING
SaferCopy: avis - SetFileDate ha fallat
MSG_VERIFY_READ_ERR
SaferCopy: verificacio - error de lectura
MSG_VERIFY_SIZE_DIFF
SaferCopy: verificacio - mides diferents (%ld vs %ld)
MSG_VERIFY_CONTENT
SaferCopy: verificacio - contingut diferent
MSG_SUMMARY_HEADER
--- Resum: %ld error(s) ---
MSG_ERRBUF_TRUNCATED
  [%ld missatge(s) truncat(s) - buffer d'errors ple]
MSG_FINAL_REPORT
SaferCopy: %ld copiat(s)  %ld omesos  %ld error(s)%s
MSG_ABORT_TAG
  [CANCEL-LAT: MAXERR assolit]
MSG_ABORT
SaferCopy: MAXERR=%ld assolit - cancel-lant
MSG_CHECK_MISSING
  Falta    %s
MSG_CHECK_OK
  OK       %s
MSG_CHECK_MISMATCH
  MidaDif  %s  (src=%ld  dst=%ld)
MSG_OPT_CHECK
, CHECK
