, UPDATE
MSG_OPT_VERBOSE
, VERBOSE
MSG_OPT_MAXERR
, MAXERR=%ld
MSG_COPYING
Kopirovat %s -> %s
MSG_IGNORED
  Preskocit %s (aktualny)
MSG_DEST_INCOMPLETE
  [ciel neuplny: %ld/%ld bajtov]
